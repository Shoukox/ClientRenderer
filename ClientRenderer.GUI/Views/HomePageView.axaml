<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClientRenderer.GUI.ViewModels"
             xmlns:app="using:ClientRenderer.GUI"
             x:DataType="vm:HomePageViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClientRenderer.GUI.Views.HomePageView"
             Foreground="White">
  <TextBlock Text="{Binding Source={x:Static app:App.Localizer}, Path=[Page.Home.Placeholder]}"
             TextWrapping="Wrap"/>
</UserControl>
