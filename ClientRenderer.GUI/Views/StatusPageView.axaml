<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ClientRenderer.GUI.ViewModels"
			 xmlns:app="using:ClientRenderer.GUI"
			 x:DataType="vm:StatusPageViewModel"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="ClientRenderer.GUI.Views.StatusPageView">
	<Border Classes="console-root" Padding="20">
		<StackPanel Spacing="20">
			<TextBlock Classes="console-title" Text="{Binding Title}" FontSize="22" />

			<Border Classes="console-toolbar" Padding="16">
				<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
					<TextBlock Grid.Row="0" Grid.Column="0"
							   Text="{Binding Source={x:Static app:App.Localizer}, Path=[Page.Status.ServerStatus]}"
							   FontSize="16"
							   VerticalAlignment="Center" />
					<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<Ellipse Width="12" Height="12" Fill="{Binding ServerStatusBrush}" />
						<TextBlock Text="{Binding ServerStatusLabel}" FontWeight="SemiBold" />
					</StackPanel>

					<TextBlock Grid.Row="1" Grid.ColumnSpan="2"
							   Text="{Binding HeartbeatFailuresLabel}"
							   TextWrapping="Wrap" />
					<StackPanel Orientation="Vertical" Spacing="7" Grid.Row="2">
						<StackPanel Orientation="Horizontal">
							<StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
								<Button Command="{Binding RestartRendererServiceCommand}"
										HorizontalAlignment="Left"
										IsEnabled="{Binding CanRunStatusActions}"
										Content="{Binding Source={x:Static app:App.Localizer}, Path=[Page.Status.RestartRendererService]}" />
								<TextBlock Text="{Binding RestartFeedbackIcon}"
										   Foreground="{Binding RestartFeedbackBrush}"
										   FontWeight="Bold"
										   VerticalAlignment="Center" />
							</StackPanel>

							<StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
								<Button Command="{Binding CheckForUpdatesCommand}"
										HorizontalAlignment="Left"
										IsEnabled="{Binding CanRunStatusActions}"
										Content="{Binding Source={x:Static app:App.Localizer}, Path=[Page.Status.CheckForUpdates]}" />
								<TextBlock Text="{Binding UpdateFeedbackIcon}"
										   Foreground="{Binding UpdateFeedbackBrush}"
										   FontWeight="Bold"
										   VerticalAlignment="Center" />
							</StackPanel>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="7"> 
							<Button Command="{Binding OpenSettingsFolderCommand}"
									HorizontalAlignment="Left"
									IsEnabled="{Binding CanRunStatusActions}"
									Content="{Binding Source={x:Static app:App.Localizer}, Path=[Page.Status.OpenSettingsFolder]}" />
							<Button Command="{Binding OpenClientRendererSettingsCommand}"
									HorizontalAlignment="Left"
									IsEnabled="{Binding CanRunStatusActions}"
									Content="{Binding Source={x:Static app:App.Localizer}, Path=[Page.Status.OpenRendererSettings]}" />
						</StackPanel>
					</StackPanel>
				</Grid>

			</Border>
		</StackPanel>
	</Border>
</UserControl>
