<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style Selector="Border.console-root">
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Console.Border}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="0"/>
	</Style>

	<Style Selector="Border.console-toolbar">
		<Setter Property="Background" Value="{DynamicResource Console.ToolbarBackground}"/>
		<Setter Property="Padding" Value="12 0"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Console.Border}"/>
		<Setter Property="BorderThickness" Value="0,0,0,1"/>
	</Style>

	<Style Selector="TextBlock.console-title">
		<Setter Property="Foreground" Value="{DynamicResource Console.Title}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="13"/>
	</Style>

	<Style Selector="ItemsControl.console-output">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="12"/>
	</Style>

	<Style Selector="TextBlock.console-output-line">
		<Setter Property="Foreground" Value="{DynamicResource Console.Text}"/>
		<Setter Property="FontFamily" Value="{DynamicResource Console}"/>
		<Setter Property="FontSize" Value="11"/>
	</Style>

	<Style Selector="Button.copyconsole-button">
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="MinWidth" Value="32" />
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="TextBlock.copyconsole-icon">
		<Setter Property="FontSize" Value="16" />
		<Setter Property="Width" Value="16" />
		<Setter Property="Height" Value="16" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Console.Title}" />
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.15"/>
			</Transitions>
		</Setter>
	</Style>
</Styles>
