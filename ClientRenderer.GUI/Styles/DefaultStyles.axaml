<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Grid RowDefinitions="*, Auto">
			<Button HorizontalAlignment="Stretch" Classes.active="true">
				<StackPanel Orientation="Horizontal">
					<Label Classes="icon" Content="&#xe2c2;" />
					<Label Classes="subtitle" Content="Home" />
				</StackPanel>
			</Button>
		</Grid>
	</Design.PreviewWith>

	<StyleInclude Source="Typography.axaml" />
	<StyleInclude Source="Buttons.axaml" />
	<StyleInclude Source="Console.axaml" />
</Styles>
